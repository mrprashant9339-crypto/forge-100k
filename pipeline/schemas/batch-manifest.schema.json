{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge100k.example/schemas/batch-manifest.schema.json",
  "title": "Forge 100K Batch Manifest",
  "type": "object",
  "required": ["schema_version", "batch_id", "output_dir", "jobs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "batch_id": {"type": "string", "minLength": 3},
    "output_dir": {"type": "string", "minLength": 1},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "asset-job.schema.json"}
    }
  },
  "additionalProperties": false
}