{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge100k.example/schemas/asset-job.schema.json",
  "title": "Forge 100K Asset Job",
  "type": "object",
  "required": [
    "asset_id",
    "archetype",
    "species",
    "style",
    "seed",
    "quality_tier",
    "target",
    "provenance"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^FG-[A-Z]{3}-[0-9]{6}$"
    },
    "archetype": {
      "type": "string",
      "minLength": 2
    },
    "species": {
      "type": "string",
      "enum": [
        "human",
        "animal",
        "fantasy",
        "robot",
        "object",
        "mascot"
      ]
    },
    "style": {
      "type": "string",
      "enum": [
        "normal",
        "armored",
        "royal",
        "winter",
        "summer",
        "ninja",
        "pirate",
        "space",
        "underwater",
        "glowing"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "quality_tier": {
      "type": "string",
      "enum": [
        "blockout",
        "prototype",
        "production",
        "game_ready"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "glTF2",
        "unity",
        "unreal",
        "godot"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "creator",
        "license",
        "license_evidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "original_procedural",
            "commissioned",
            "licensed"
          ]
        },
        "creator": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "license": {
          "type": "string"
        },
        "license_evidence": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    },
    "face_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jaw_width": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.35
        },
        "jaw_height": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3
        },
        "cheek_fullness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eye_scale": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.25
        },
        "eye_spacing": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2
        },
        "nose_width": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3
        },
        "nose_length": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3
        },
        "mouth_width": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.25
        },
        "brow_depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "chin_projection": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3
        }
      }
    },
    "body_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.25
        },
        "shoulder_width": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.3
        },
        "torso_ratio": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.25
        },
        "arm_length": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2
        },
        "leg_length": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2
        },
        "muscle": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mass": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,63}$"
      }
    },
    "rig_profile": {
      "type": "string",
      "enum": [
        "humanoid_v1",
        "quadruped_v1",
        "avian_v1",
        "mechanical_v1"
      ]
    }
  },
  "additionalProperties": false
}