{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge100k.example/schemas/asset-job.schema.json",
  "title": "Forge 100K Asset Job",
  "type": "object",
  "required": [
    "asset_id",
    "archetype",
    "species",
    "style",
    "seed",
    "quality_tier",
    "target",
    "provenance"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^FG-[A-Z]{3}-[0-9]{6}$"
    },
    "archetype": {
      "type": "string",
      "minLength": 2
    },
    "species": {
      "type": "string",
      "enum": [
        "human",
        "animal",
        "fantasy",
        "robot",
        "object",
        "mascot"
      ]
    },
    "style": {
      "type": "string",
      "enum": [
        "normal",
        "armored",
        "royal",
        "winter",
        "summer",
        "ninja",
        "pirate",
        "space",
        "underwater",
        "glowing"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "quality_tier": {
      "type": "string",
      "enum": [
        "blockout",
        "prototype",
        "production",
        "game_ready"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "glTF2",
        "unity",
        "unreal",
        "godot"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "creator",
        "license",
        "license_evidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "original_procedural",
            "commissioned",
            "licensed"
          ]
        },
        "creator": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "license": {
          "type": "string"
        },
        "license_evidence": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}